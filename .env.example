# Trip Sync v2 Environment Variables
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the actual values

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ============================================
# OAUTH CONFIGURATION
# ============================================
# Google OAuth (https://console.cloud.google.com/)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id

# Apple Sign In (https://developer.apple.com/)
EXPO_PUBLIC_APPLE_SERVICE_ID=your_apple_service_id

# Facebook OAuth (https://developers.facebook.com/)
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# ============================================
# EXTERNAL SERVICES
# ============================================
# Google Maps API (https://console.cloud.google.com/)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OCR Service (Choose one)
# Option 1: Google Document AI
EXPO_PUBLIC_GOOGLE_DOCUMENT_AI_PROJECT_ID=your_project_id
GOOGLE_DOCUMENT_AI_KEY=your_service_account_key_json

# Option 2: AWS Textract
EXPO_PUBLIC_AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Exchange Rate API (https://exchangerate-api.com/)
EXPO_PUBLIC_EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
EXPO_PUBLIC_EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6/

# ============================================
# PUSH NOTIFICATIONS
# ============================================
# Expo Push Service (Managed)
EXPO_PUBLIC_PUSH_ENABLED=true

# iOS Push Certificates (Production only)
IOS_PUSH_CERT_PATH=./certificates/ios-push-cert.p12
IOS_PUSH_CERT_PASSWORD=your_cert_password

# Firebase Cloud Messaging (Android)
EXPO_PUBLIC_FCM_SERVER_KEY=your_fcm_server_key

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry Error Tracking (https://sentry.io/)
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@sentry.io/YOUR_PROJECT
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# Analytics (Optional - choose one)
# Option 1: Google Analytics
EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Option 2: Mixpanel
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# ============================================
# DEVELOPMENT & TESTING
# ============================================
# Test Environment
EXPO_PUBLIC_TEST_MODE=false
EXPO_PUBLIC_MOCK_API=false

# Development Tools
EXPO_PUBLIC_ENABLE_DEVTOOLS=true
EXPO_PUBLIC_LOG_LEVEL=debug

# ============================================
# BUILD CONFIGURATION
# ============================================
# EAS Build
EAS_PROJECT_ID=your_eas_project_id
EXPO_PUBLIC_EAS_BUILD_PROFILE=development

# App Configuration
EXPO_PUBLIC_APP_NAME="Trip Sync"
EXPO_PUBLIC_APP_SLUG="trip-sync"
EXPO_PUBLIC_APP_SCHEME="tripsync"

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
# Environment
EXPO_PUBLIC_ENVIRONMENT=development # development | staging | production
EXPO_PUBLIC_API_TIMEOUT=30000 # 30 seconds

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# ============================================
# SECURITY
# ============================================
# Encryption Keys (Generate securely)
EXPO_PUBLIC_ENCRYPTION_KEY=generate_32_char_key_here
MMKV_ENCRYPTION_KEY=generate_secure_key_for_storage

# API Rate Limiting
EXPO_PUBLIC_API_RATE_LIMIT=100 # requests per minute
EXPO_PUBLIC_API_BURST_LIMIT=20 # burst allowance

# ============================================
# REGIONAL CONFIGURATION
# ============================================
# Default Region
EXPO_PUBLIC_DEFAULT_REGION=US
EXPO_PUBLIC_DEFAULT_CURRENCY=USD
EXPO_PUBLIC_DEFAULT_LOCALE=en-US
EXPO_PUBLIC_DEFAULT_TIMEZONE=America/New_York

# ============================================
# NOTES FOR DEVELOPERS
# ============================================
# 1. Never commit real keys to the repository
# 2. Use different keys for dev/staging/prod
# 3. Rotate keys regularly (every 90 days)
# 4. Store service keys securely (use secret manager in production)
# 5. Document any new environment variables here
# 6. Test with missing variables to ensure proper error handling

# ============================================
# VALIDATION CHECKLIST
# ============================================
# Before running the app, ensure:
# [ ] All required variables are set
# [ ] Supabase project is created and running
# [ ] OAuth apps are configured with correct redirect URLs
# [ ] API keys have appropriate restrictions
# [ ] Push certificates are valid (production only)
# [ ] Monitoring services are configured